# %% [markdown]
# # Twisted Truths: Episode 1 - Kaggle GPU Production Pipeline
# This notebook automates the generation of high-quality assets (Audio and Images) for the "The Best Friend Betrayal" episode.
# It uses **ChatterboxTTS** for narration and **FLUX.1-schnell** for cinematic image generation.

# %% [markdown]
# ## STEP 1 — INSTALL
# Install necessary libraries for TTS, Image Generation, and Audio processing.

# %%
!pip install -q chatterbox-tts diffusers transformers accelerate soundfile torch huggingface_hub tqdm

import os
import json
import torch
import shutil
import soundfile as sf
from tqdm.auto import tqdm
from diffusers import FluxPipeline
from huggingface_hub import hf_hub_download
import datetime

# Create working directories
os.makedirs('/kaggle/working/audio', exist_ok=True)
os.makedirs('/kaggle/working/images', exist_ok=True)

print("✅ Installation complete.")

# %% [markdown]
# ## STEP 2 — CHATTERBOX TTS
# Load the ChatterboxTTS model on GPU and generate WAV audio for each scene.
# Voice Style: warm, suspenseful, deliberate female.
# Speed: 0.92.

# %%
# Note: This assumes chatterbox-tts is correctly installed and available via the expected import.
# If the library structure differs, adjustments may be needed.
try:
    from chatterbox_tts import ChatterboxTTS
except ImportError:
    # Fallback/Mock for structure demonstration if library is not in standard path
    print("⚠️ ChatterboxTTS import failed. Ensure the library is correctly installed.")
    class ChatterboxTTS:
        def __init__(self, device): self.device = device
        def generate(self, text, speaker, speed, output_path): pass

print("🚀 Loading ChatterboxTTS on CUDA...")
device = "cuda" if torch.cuda.is_available() else "cpu"
tts = ChatterboxTTS(device=device)

# Load the script
with open('/workspaces/OpenMontage/projects/twisted-truths-ep1/script.json', 'r') as f:
    script_data = json.load(f)

scenes = script_data['scenes']
print(f"📝 Loaded {len(scenes)} scenes from script.")

print("🎙️ Generating audio files...")
for scene in tqdm(scenes, desc="TTS Generation"):
    scene_id = scene['id']
    text = scene['narration']
    output_path = f"/kaggle/working/audio/{scene_id}.wav"
    
    try:
        # Voice configuration per requirements
        # Assuming 'warm_suspenseful_female' is a valid speaker ID in ChatterboxTTS
        tts.generate(
            text=text,
            speaker="warm_suspenseful_female", 
            speed=0.92,
            output_path=output_path
        )
        
        # Get duration using soundfile
        data, samplerate = sf.read(output_path)
        duration = len(data) / samplerate
        print(f"✅ {scene_id}: {duration:.2f}s | Status: Success")
        
    except Exception as e:
        print(f"❌ {scene_id}: Error - {str(e)}")
        continue

torch.cuda.empty_cache()
print("✅ TTS Step Complete.")

# %% [markdown]
# ## STEP 3 — FLUX IMAGE GENERATION
# Load FLUX.1-schnell on GPU and generate 1 cinematic 16:9 image per scene.

# %%
print("🚀 Loading FLUX.1-schnell on CUDA...")
pipe = FluxPipeline.from_pretrained("black-forest-labs/FLUX.1-schnell", torch_dtype=torch.bfloat16)
pipe.to(device)

print("🖼️ Generating cinematic images...")
for scene in tqdm(scenes, desc="Image Generation"):
    scene_id = scene['id']
    narration = scene['narration']
    output_path = f"/kaggle/working/images/{scene_id}.png"
    
    # Prompt Engineering
    # We use the narration to derive the visual description. 
    # For a production pipeline, a LLM call would usually do this. 
    # Here we use the scene context.
    visual_description = narration # Simplification for this notebook
    
    prompt = (
        f"{visual_description}, cinematic film still, "
        "dramatic chiaroscuro lighting, dark teal and amber color palette, "
        "film noir aesthetics, photorealistic, sharp focus, "
        "anamorphic lens bokeh, 8K resolution, emotional tension, shot on Arri Alexa"
    )
    
    try:
        # Generate image (16:9 aspect ratio)
        # Schnell is optimized for fewer steps
        image = pipe(
            prompt, 
            guidance_scale=0.0, 
            num_inference_steps=4, 
            width=1344, 
            height=768
        ).images[0]
        
        image.save(output_path)
        
        # Get file size
        file_size = os.path.getsize(output_path) / 1024 # KB
        print(f"✅ {scene_id}: {file_size:.2f} KB | Status: Success")
        
    except Exception as e:
        print(f"❌ {scene_id}: Error - {str(e)}")
        continue

torch.cuda.empty_cache()
print("✅ Image Generation Step Complete.")

# %% [markdown]
# ## STEP 4 — ZIP AND DOWNLOAD
# Package all assets into a single ZIP file.

# %%
print("📦 Zipping assets...")
zip_name = "/kaggle/working/twisted-truths-assets.zip"
output_dir = "/kaggle/working"

# Create a temporary staging folder to maintain structure in ZIP
staging_dir = "/kaggle/working/staging"
os.makedirs(staging_dir, exist_ok=True)
shutil.copytree('/kaggle/working/audio', f"{staging_dir}/audio")
shutil.copytree('/kaggle/working/images', f"{staging_dir}/images")

shutil.make_archive(zip_name.replace('.zip', ''), 'zip', staging_dir)

# Cleanup staging
shutil.rmtree(staging_dir)

# Final Summary
audio_count = len([f for f in os.listdir('/kaggle/working/audio') if f.endswith('.wav')])
image_count = len([f for f in os.listdir('/kaggle/working/images') if f.endswith('.png')])
zip_size = os.path.getsize(zip_name) / (1024 * 1024) # MB

print("
" + "="*30)
print("🔥 PIPELINE COMPLETE 🔥")
print("="*30)
print(f"Total Audio Files: {audio_count}")
print(f"Total Images:      {image_count}")
print(f"Zip File Size:     {zip_size:.2f} MB")
print(f"Download:          {zip_name}")
print("="*30)
